{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/downloads/(.*)",
      "destination": "https://github.com/abdul-qadir-arhaam/SplitUp/releases/download/v1.0.2/splitup-v1.0.2.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/app/version", "destination": "/website/api/version" },
    { "source": "/version", "destination": "/website/api/version" },
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/(.*)", "destination": "/website/$1" }
  ]
}
