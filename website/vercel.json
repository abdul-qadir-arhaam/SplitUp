{
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "**"
    }
  },
  "redirects": [
    {
      "source": "/downloads/(.*)",
      "destination": "https://github.com/abdul-qadir-arhaam/SplitUp/releases/download/v1.0.2/splitup-v1.0.2.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app/version", "destination": "/api/version" },
    { "source": "/version", "destination": "/api/version" }
  ]
}
