{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/downloads/(.*)",
      "destination": "https://github.com/abdul-qadir-arhaam/SplitUp/releases/download/v1.0.0.apk/splitup-v1.0.0.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app/version", "destination": "/api/version" },
    { "source": "/version", "destination": "/api/version" }
  ]
}
